GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash" # Optional: override the AI model
DATABASE_URL="postgres://user:password@host:port/dbname" # For Render PG deploy
# SSL is on by default (required by Render). Set to "disable" for a non-SSL
# Postgres (local / self-hosted) to avoid "server does not support SSL".
PGSSL=""
PORT=3001

# Secret used to sign auth tokens. MUST be set in production; if unset a random
# per-process secret is used (tokens are invalidated on restart).
AUTH_SECRET="change-me-to-a-long-random-string"

# Invite code required to register a CO account. MUST be set in production
# (render.yaml generates one); when unset, registration is open (local dev).
# Share it out-of-band with new field officers.
REGISTRATION_INVITE_CODE=""

# Supplya backend used to verify admin credentials (admin-login proxy).
# Rill never stores admin passwords; supplya-backend is not modified.
SUPPLYA_API_BASE="https://supplya-backend-3t2x.onrender.com/api/v1"

# Optional comma-separated browser CORS allowlist (e.g. https://app.rill.com).
# When unset, CORS is open (dev / bundled static web app). The native mobile
# app is unaffected either way (it sends no Origin header).
ALLOWED_ORIGINS=""
